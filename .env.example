# Public URL used for metadata/canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for the conceptual standalone demo.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Hero video can be overridden without editing code.
NEXT_PUBLIC_HERO_VIDEO_URL=https://res.cloudinary.com/pwsxcwoz/video/upload/v1789067607/Architectural_scene_video_loop_1080p_20260910161248.mp4

# Contact behavior:
# log      = local development; logs sanitized payload server-side
# resend   = sends through Resend REST API
# disabled = returns a non-operational response
CONTACT_MODE=log

# Required only when CONTACT_MODE=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
